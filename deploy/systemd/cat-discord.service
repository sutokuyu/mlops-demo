[Unit]
Description=Discord bot that answers cat-report questions in a channel
After=network-online.target
# A bad token or an empty allowlist restarting forever would be easy to miss and
# would spam Discord's login endpoint. Ten tries in five minutes means the
# configuration itself is broken, so leave the unit failed where
# `systemctl --user status` will show it.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/projects/mlops-demo
ExecStart=%h/projects/mlops-demo/scripts/run_discord_bot.sh
# The Gateway connection drops (network blips, Discord restarts); reconnect
# without a human.
Restart=always
RestartSec=10
# Unlike the tracker there is no open visit that a signal could cut short,
# and discord.py closes the Gateway session itself on SIGTERM, so the default
# signal is correct here.
TimeoutStopSec=30
# Reading a database and waiting on an HTTP reply: never in the way of anything.
Nice=10

[Install]
WantedBy=default.target
