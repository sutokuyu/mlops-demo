[Unit]
Description=Cat location tracker (samples the room cameras and records visits)
After=network-online.target
# A configuration mistake would otherwise restart every RestartSec forever and
# be easy to miss. Ten tries in five minutes means the startup itself is broken,
# so leave the unit failed where `systemctl --user status` will show it.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/projects/mlops-demo
ExecStart=%h/projects/mlops-demo/scripts/run_tracker.sh
# Cameras drop out and the GPU can hiccup; recover without a human.
Restart=always
RestartSec=10
# SIGTERM would kill the interpreter before the tracker's cleanup block closes
# the visit that was open when the service stopped. SIGINT raises the
# KeyboardInterrupt that run() already handles, so the day is not left with a
# dangling visit.
KillSignal=SIGINT
TimeoutStopSec=30
# Sampling every few seconds leaves the CPU idle most of the time; stay out of
# the way of anything interactive.
Nice=5

[Install]
WantedBy=default.target
